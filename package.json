{
  "name": "aulaviva",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrar:local": "wrangler d1 migrations apply incidencias --local",
    "db:migrar:remoto": "wrangler d1 migrations apply incidencias --remote",
    "db:semilla:local": "wrangler d1 execute incidencias --local --file=seed/aulas.sql",
    "db:semilla:remoto": "wrangler d1 execute incidencias --remote --file=seed/aulas.sql",
    "tipos": "wrangler types",
    "push:claves": "node scripts/claves-push.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wrangler": "^4.148.0"
  }
}
