# Copia este archivo como .dev.vars para desarrollo local.
# Solo funciona en localhost; en producción se entra con Cloudflare Access
TOKEN_TI=cambia-esta-clave

# Simula a un docente para probar la página del QR en http://localhost:5173/r/204
DEV_EMAIL_DOCENTE=docente.prueba@innovaschools.edu.pe

# Desactiva Cloudflare Access en local (en producción lo activa wrangler.jsonc)
ACCESS_AUD=

# Opcional: quién ve la pestaña Monitoreo ML. Sin esto, todo TI (en local, ti@local)
# MONITOREO_EMAILS=ti@local

# Opcional: para probar la vista de COA (ve todo y solo cambia Daños y mantenimiento)
# TOKEN_COA=clave-coa
