{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aulaviva",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/r/*", "/docente", "/docente/"]
  },
  // Cloudflare Access de la sede (ver docs/cloudflare-access.md). En local, .dev.vars deja
  // ACCESS_AUD vacío para que TI entre con la clave TOKEN_TI.
  // Los correos de TI no van aquí porque el repositorio es público:
  // se guardan como secreto con `npx wrangler secret put TI_EMAILS`.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://aulaviva-smp1.cloudflareaccess.com",
    "ACCESS_AUD": "cda2af380f36b3b65705c17219cf7e7b7a3cd01f0db6bcee87c955e7b5f7ff95",
    "DOMINIO_DOCENTES": "innovaschools.edu.pe"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "incidencias",
      // Si creas otra base con `npx wrangler d1 create incidencias`, cambia este id
      "database_id": "348d9ee6-aea3-48ac-ad15-691f79485411",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Fotos de evidencia. Crea el bucket con: npx wrangler r2 bucket create aulaviva-fotos
    { "binding": "FOTOS", "bucket_name": "aulaviva-fotos" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SEDE_EN_VIVO", "class_name": "SedeEnVivo" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SedeEnVivo"] }],
  "observability": { "enabled": true }
}
